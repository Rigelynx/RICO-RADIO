# ==========================================
# CONFIGURACIÓN SECRETA DEL SARGENTO RICO
# ==========================================

# Token del bot (obtenido en Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=TU_TOKEN_AQUI

# Client ID / Application ID del bot (Discord Developer Portal > General Information)
CLIENT_ID=TU_CLIENT_ID_AQUI

# ID del servidor de Discord donde opera la unidad militar (Clic derecho en el servidor > Copiar ID)
GUILD_ID=TU_GUILD_ID_AQUI

# Puerto para el panel web táctico
PORT=3000

# Clave o PIN de seguridad para autorizar cambios en el panel web
WEB_ADMIN_KEY=sargento123
